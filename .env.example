# Copy this file to .env and fill in the key for the provider you choose.
#   cp .env.example .env

# --- LLM provider -----------------------------------------------------------
# LLM_PROVIDER and LLM_MODEL go together: each provider has its own model names.
# Default (recommended): Claude API.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Alternative: Gemini API (free tier). Key from https://aistudio.google.com/apikey
# LLM_PROVIDER=google
# LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=

# Alternative: OpenRouter (has free models, with a low daily request limit).
# LLM_PROVIDER=openrouter
# LLM_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_API_KEY=

# --- Optional ---------------------------------------------------------------
# LangSmith tracing (see each model and tool call of a conversation).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# Pretend today is this date (YYYY-MM-DD). The sample orders are from late 2025
# and early 2026, so this lets you demo an in-window return, e.g. 2026-02-20.
# REFERENCE_DATE=
